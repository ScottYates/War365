# dev junk
.DS_Store
Thumbs.db
*.log
node_modules/
.idea/
.vscode/

# local previews
preview-*.png
test/shots/

# go build output (rebuild with `go build` or skip with `go run .`)
*.exe
/bin/

# dev server runtime state (scripts/start.sh)
/.war365.pid

# scratch commit message files
/.commitmsg.tmp

# python bytecode from the tools/ scripts
__pycache__/
*.pyc

# the server-side python venv (scripts/install-scan.sh)
.venv/

# credentials. The MiniMax key belongs in /etc/war365/minimax.env on the
# server, never in here.
*.env
.env
minimax.env
*.pem
*.key
id_rsa*
scan_key*
