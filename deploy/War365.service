# War365 server — systemd unit.
#
# Assumes the repo is checked out to /opt/War365.
#
# Install:
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin war365
#   sudo chown -R war365:war365 /opt/War365
#   sudo /opt/War365/scripts/build.sh          # binary must exist before start
#   sudo cp deploy/War365.service /etc/systemd/system/war365.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now war365
#
# Day to day:
#   systemctl status war365
#   journalctl -u war365 -f
#   tail -f /var/log/war365/access.log
#   systemctl restart war365
#
# Change the port without editing this file:
#   sudo systemctl edit war365
#   [Service]
#   Environment=WAR365_ADDR=:9000
#
# If nginx sits in front, bind to loopback only:
#   Environment=WAR365_ADDR=127.0.0.1:8000
#
# Access logs are appended to /var/log/war365/access.log and mirrored to the
# journal. Restarts add to the file; they never truncate it. Rotate with
# deploy/War365.logrotate.

[Unit]
Description=War365 static site server
Documentation=https://github.com/ScottYates/War365
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=war365
Group=war365
WorkingDirectory=/opt/War365

Environment=WAR365_ADDR=:8000
Environment=WAR365_LOG_FILE=/var/log/war365/access.log

# LogsDirectory= creates /var/log/war365 owned by User=/Group= and marks it
# writable, which ProtectSystem=strict would otherwise deny. Without this the
# service has nowhere to write and the file sink silently cannot be used.
LogsDirectory=war365
LogsDirectoryMode=0750

# Fail fast with an actionable message if the binary was never built.
ExecStartPre=/bin/sh -c 'test -x /opt/War365/bin/war365 || { echo "war365: binary missing. Run: sudo /opt/War365/scripts/build.sh" >&2; exit 1; }'

ExecStart=/opt/War365/bin/war365 -addr=${WAR365_ADDR}

Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=war365

# Hardening. The server only ever reads files, so a read-only root is fine.
# Note: no SystemCallFilter here on purpose — restrictive syscall filters are
# known to break the Go runtime (clone/mmap/rseq/membarrier).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

# AF_NETLINK is required: Go's net package enumerates interfaces via netlink.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
