# War365 news scan - environment.
#
# Copy to /etc/war365/minimax.env, fill it in, then:
#
#   sudo chown root:war365 /etc/war365/minimax.env
#   sudo chmod 0640 /etc/war365/minimax.env
#
# The systemd unit reads it with EnvironmentFile, so the values must be
# unquoted shell-free KEY=VALUE pairs, except where a value contains
# spaces, which systemd wants in double quotes.
#
# systemd does not read shell syntax: no `export`, no $(...), no line
# continuation.

# --- The MiniMax credential ---------------------------------------------------
#
# Get a key from the MiniMax platform:
#
#   pay-as-you-go:  https://platform.minimax.io/user-center/basic-information/interface-key
#   M Plan seat:    https://platform.minimax.io/user-center/payment/token-plan
#
# Both give you a Subscription Key or API Key. It goes here, and nowhere
# else. It is never written to the repository and never printed by the
# tooling.
MINIMAX_API_KEY=PASTE_YOUR_KEY_HERE

# The endpoint. The default is the public Anthropic-compatible platform API.
# Leave it alone unless you have a reason.
MINIMAX_BASE_URL=https://api.minimax.io/anthropic

# Which auth header the endpoint wants: bearer or x-api-key. The platform
# API accepts bearer, which is the default.
MINIMAX_AUTH_STYLE=bearer

# The model that ranks the candidates and writes the entries.
MINIMAX_MODEL=MiniMax-M3.1-Flash

# Thinking effort for the model. low is plenty for ranking and writing.
MINIMAX_EFFORT=low

# --- The browser --------------------------------------------------------------
#
# The tooling parses commits.js with a real browser, and Playwright
# downloads that browser separately from the package that drives it. It
# goes in one fixed directory. The unit carries the same value, but the
# unit is a copy on disk and this file is read every time the service
# starts, so this one is the one that counts.
PLAYWRIGHT_BROWSERS_PATH=/var/lib/war365/browsers

# --- Git identity -------------------------------------------------------------
#
# The commits the scan makes are authored by the bot, not by a person.
GIT_AUTHOR_NAME=War365 Release Bot
GIT_AUTHOR_EMAIL=release-bot@war365.example
GIT_COMMITTER_NAME=War365 Release Bot
GIT_COMMITTER_EMAIL=release-bot@war365.example

# --- Push access --------------------------------------------------------------
#
# The scan pushes its own commits, so it needs a write-enabled deploy key.
# Generate one with:
#   sudo ssh-keygen -t ed25519 -N '' -f /etc/war365/scan_key
# and add the contents of /etc/war365/scan_key.pub to the repository under
# Settings > Deploy keys, with "Allow write access" ticked.
GIT_SSH_COMMAND="ssh -i /etc/war365/scan_key -o IdentitiesOnly=yes -o UserKnownHostsFile=/etc/war365/known_hosts -o StrictHostKeyChecking=accept-new"

# --- Tuning -------------------------------------------------------------------
#
# How many entries one run may add, how far back to look, and the score the
# top candidate must beat for anything to ship at all.
WAR365_SCAN_TOP=3
WAR365_SCAN_DAYS=3
WAR365_SCAN_MIN_SCORE=60
