# Shell scripts must keep LF endings. Without this, autocrlf on Windows
# rewrites them to CRLF and they fail on Linux with `$'\r': command not found`.
*.sh text eol=lf

# systemd unit files are also parsed by a strict line-oriented parser on Linux.
*.service text eol=lf

# Same for logrotate snippets.
*.logrotate text eol=lf

# The helper scripts in the root have no extension, so name them.
pull text eol=lf
showlog text eol=lf

# Default: let git handle text files normally.
* text=auto
